# Copy this file to ".env" and fill in your key(s). The real .env is git-ignored.
#
# The LLM-powered "Refine" feature uses Gemini if a real GEMINI_API_KEY is set,
# else Claude if ANTHROPIC_API_KEY is set, else built-in keyword rules.

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
# Optional: override the model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (optional alternative) — https://console.anthropic.com
# ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_KEY
# REFINE_MODEL=claude-opus-4-8
